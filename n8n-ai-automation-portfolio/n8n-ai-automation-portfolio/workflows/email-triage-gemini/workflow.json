          "cachedResultName": "models/gemini-3.8-flash"
        },
        "builtInTools": {},
        "messages": {
          "values": [
            {
              "content": "=Write the order confirmation email for this incoming order email:\n\nSubject: {{ $(\"Gmail Trigger\").item.json.Subject }}\nFrom: {{ $(\"Gmail Trigger\").item.json.From }}\n\n{{ $(\"Gmail Trigger\").item.json.snippet }}"
            }
          ]
        },
        "options": {
          "systemMessage": "Act as a customer support specialist. Write a clear, professional order confirmation email for an order. Include placeholders for Order Number, Item List, Total Amount, Estimated Delivery Date, and Shipping Address. End with a polite thank you and a support contact link."
        }
      }
    },
    {
      "name": "Reply to Inquiry",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        576,
        96
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_ME",
          "name": "YOUR_GEMINI_CREDENTIAL"
        }
      },
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3.8-flash",
          "cachedResultName": "models/gemini-3.8-flash"
        },
        "simplify": false,
        "builtInTools": {},
        "messages": {
          "values": [
            {
              "content": "=Act as a helpful and professional customer support agent. Draft a clear, concise reply addressing the sender's inquiry directly. If any details are missing (such as account numbers or specific dates), use clear placeholders like [Insert Detail Here] instead of guessing. Always end with a polite closing and a standard support sign-off.\n\nWrite a reply to this customer inquiry email:\n\nSubject: {{ $(\"Gmail Trigger\").item.json.Subject }}\nFrom: {{ $(\"Gmail Trigger\").item.json.From }}\n\n{{ $(\"Gmail Trigger\").item.json.snippet }}"
            }
          ]
        },
        "options": {
          "systemMessage": "Act as a customer support specialist. Write a clear, friendly, professional reply to the customer inquiry. Address the customer's question directly; if specific details are unknown, use clear placeholders instead of inventing facts. Offer further help and end with a polite sign-off and a support contact link."
        }
      }
    },
